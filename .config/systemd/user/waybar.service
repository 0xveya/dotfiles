[Unit]
Description=Waybar
# Niri exports the Wayland session environment as it becomes ready.  Starting
# before it races that export and makes Waybar fail with an empty display.
After=niri.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/github/Waybar/build/waybar
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
